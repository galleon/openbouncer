__pycache__/
*.pyc
.venv/
.pytest_cache/
*.egg-info/

# Real API key config (contains key hashes) -- keep only the .example.yaml template tracked.
/config/api_keys.yaml

# Admin action audit log (app/core/audit.py) -- a runtime-generated file,
# same reasoning as api_keys.yaml (it can contain full before/after config
# file snapshots, including key_hash values).
/config/audit_log.jsonl

# Per-request guardrail decision log (app/core/guardrail_events.py) -- a
# runtime-generated file that can contain matched prompt-injection phrases,
# same reasoning as audit_log.jsonl above.
/config/guardrail_events.jsonl

# docker-compose env overrides (REDIS_URL, HF_TOKEN, VLLM_IMAGE, etc.) -- local machine config, may hold secrets.
/.env

# Local Claude Code session/tool settings, not project source.
/.claude/

# UI design reference screenshots -- not project source, may be large binaries.
/samples/

# macOS Finder metadata.
.DS_Store
