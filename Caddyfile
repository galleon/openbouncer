# Turns metrics collection on globally. This is deliberately *not* exposed
# via the admin API (which defaults to 127.0.0.1:2019 inside this
# container and allows live reconfiguration, not just reading metrics --
# widening that just for scraping would be a real security downgrade).
# Instead, the standalone :9090 block below exposes a read-only /metrics
# endpoint on its own listener. No `ports:` mapping for 9090 in
# docker-compose.yml -- reachable from other containers on the docker
# network (i.e. Prometheus, via `caddy:9090`) but not published to the
# host or the public internet.
{
	metrics
}

{$DOMAIN} {
	tls {
		dns gandi {env.GANDI_API_TOKEN}
	}
	reverse_proxy gateway:8000
}

:9090 {
	metrics /metrics
}
